<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ON -->
    <item android:state_checked="true">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
            <size
                android:width="20dp"
                android:height="18dp" />
        </shape>
    </item>

    <!-- OFF -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
            <size
                android:width="20dp"
                android:height="18dp" />
        </shape>
    </item>

</selector>