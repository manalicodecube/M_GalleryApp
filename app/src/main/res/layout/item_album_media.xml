<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="2dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivAlbumMedia"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#F0F0F0"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/RoundedPhotoCorner" />

    <ImageView
        android:id="@+id/ivAlbumMediaPlay"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_play_btn"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/ivAlbumMedia"
        app:layout_constraintEnd_toEndOf="@id/ivAlbumMedia"
        app:layout_constraintStart_toStartOf="@id/ivAlbumMedia"
        app:layout_constraintTop_toTopOf="@id/ivAlbumMedia" />

    <TextView
        android:id="@+id/tvAlbumMediaDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_duration_badge"
        android:fontFamily="sans-serif-medium"
        android:paddingHorizontal="5dp"
        android:paddingVertical="2dp"
        android:text="0:00"
        android:textColor="@color/white"
        android:textSize="10sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/ivAlbumMedia"
        app:layout_constraintEnd_toEndOf="@id/ivAlbumMedia" />

    <ImageView
        android:id="@+id/ivFavoriteBadge"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="6dp"
        android:layout_marginBottom="6dp"
        android:src="@drawable/ic_heart_filled"
        android:visibility="gone"
        app:tint="#EF4444"
        app:layout_constraintBottom_toBottomOf="@id/ivAlbumMedia"
        app:layout_constraintStart_toStartOf="@id/ivAlbumMedia" />

    <ImageView
        android:id="@+id/ivSelectCheck"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="6dp"
        android:src="@drawable/icn_unselected"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/ivAlbumMedia"
        app:layout_constraintTop_toTopOf="@id/ivAlbumMedia" />

</androidx.constraintlayout.widget.ConstraintLayout>
