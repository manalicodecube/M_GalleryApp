<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootVideoDetail"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <com.developer.manali.galleryapp.util.ZoomableFrameLayout
        android:id="@+id/videoContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <VideoView
            android:id="@+id/videoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

    </com.developer.manali.galleryapp.util.ZoomableFrameLayout>

    <ProgressBar
        android:id="@+id/progressBuffering"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/lumina_primary"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutControlsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/topBarVideoDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_video_player_gradient_top"
            android:paddingHorizontal="10dp"
            android:paddingTop="28dp"
            android:paddingBottom="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/btnBackVideoDetail"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_player_control_circle"
                android:contentDescription="Back"
                android:padding="9dp"
                android:src="@drawable/arrowback"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="#FFFFFF" />

            <LinearLayout
                android:id="@+id/layoutTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="8dp"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/ivEqualizerVideo"
                app:layout_constraintStart_toEndOf="@id/btnBackVideoDetail"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tvVideoDetailTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:fontFamily="sans-serif-bold"
                    android:maxLines="1"
                    android:text="VID_20260815.mp4"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvVideoIndexCounter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif"
                    android:text="1 of 10 • 15 Aug, 2026"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivEqualizerVideo"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_player_control_circle"
                android:contentDescription="Equalizer"
                android:padding="8dp"
                android:src="@drawable/ic_equalizer"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/ivAspectRatio"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="#FFFFFF" />

            <ImageView
                android:id="@+id/ivAspectRatio"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_player_control_circle"
                android:contentDescription="Aspect Ratio"
                android:padding="8dp"
                android:src="@drawable/ic_aspect_ratio"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/ivShareVideo"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="#FFFFFF" />

            <ImageView
                android:id="@+id/ivShareVideo"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_player_control_circle"
                android:contentDescription="Share"
                android:padding="9dp"
                android:src="@drawable/share"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/ivDeleteVideo"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="#FFFFFF" />

            <ImageView
                android:id="@+id/ivDeleteVideo"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_player_control_circle"
                android:contentDescription="Delete"
                android:padding="9dp"
                android:src="@drawable/delete"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/ivInfoVideo"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="#FFFFFF" />

            <ImageView
                android:id="@+id/ivInfoVideo"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_player_control_circle"
                android:contentDescription="Details"
                android:padding="9dp"
                android:src="@drawable/info"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/ivMenuVideo"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="#FFFFFF" />

            <ImageView
                android:id="@+id/ivMenuVideo"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_player_control_circle"
                android:contentDescription="More"
                android:padding="9dp"
                android:src="@drawable/menu"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="#FFFFFF" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bottomBarVideoDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_video_player_gradient_bottom"
            android:paddingHorizontal="14dp"
            android:paddingTop="36dp"
            android:paddingBottom="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                android:id="@+id/layoutCenterControls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintBottom_toTopOf="@id/seekBarRow"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/btnPrevVideo"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_player_control_circle"
                    android:contentDescription="Previous Video"
                    android:padding="11dp"
                    android:src="@drawable/previous"
                    app:tint="#FFFFFF" />

                <ImageView
                    android:id="@+id/btnRewind10"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/bg_player_control_circle"
                    android:contentDescription="Rewind 10 seconds"
                    android:padding="11dp"
                    android:src="@drawable/replay10"
                    app:tint="#FFFFFF" />

                <ImageView
                    android:id="@+id/btnPlayPauseCenter"
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:contentDescription="Play/Pause"
                    android:elevation="6dp"
                    android:padding="16dp"
                    android:src="@drawable/pause"
                    app:tint="#FFFFFF" />

                <ImageView
                    android:id="@+id/btnForward10"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/bg_player_control_circle"
                    android:contentDescription="Forward 10 seconds"
                    android:padding="11dp"
                    android:src="@drawable/forward10"
                    app:tint="#FFFFFF" />

                <ImageView
                    android:id="@+id/btnNextVideo"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="14dp"
                    android:background="@drawable/bg_player_control_circle"
                    android:contentDescription="Next Video"
                    android:padding="11dp"
                    android:src="@drawable/next"
                    app:tint="#FFFFFF" />

            </LinearLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/seekBarRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <TextView
                    android:id="@+id/tvCurrentTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="0:00"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />


                <SeekBar
                    android:id="@+id/seekBarVideo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="6dp"
                    android:max="1000"
                    android:paddingVertical="8dp"
                    android:progressBackgroundTint="#66FFFFFF"
                    android:progressTint="@color/lumina_primary"
                    android:thumbTint="#FFFFFF"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/tvTotalDuration"
                    app:layout_constraintStart_toEndOf="@id/tvCurrentTime"
                    app:layout_constraintTop_toTopOf="parent" />


                <TextView
                    android:id="@+id/tvTotalDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="0:00"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
