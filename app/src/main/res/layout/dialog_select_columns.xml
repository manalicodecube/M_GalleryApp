<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_rounded"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="16dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#E0E3EA" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@string/sans_serif_black"
        android:text="@string/grid_columns"
        android:textColor="@color/lumina_text_title"
        android:textSize="20sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rgColumns"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <RadioButton
            android:id="@+id/rbColumn2"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:buttonTint="@color/accent_main"
            app:buttonTint="@color/accent_main"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="12dp"
            android:text="@string/_2_columns"
            android:textColor="@color/lumina_text_title"
            android:textSize="15sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F0F2F5" />

        <RadioButton
            android:id="@+id/rbColumn3"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:buttonTint="@color/accent_main"
            app:buttonTint="@color/accent_main"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="12dp"
            android:text="@string/_3_columns"
            android:textColor="@color/lumina_text_title"
            android:textSize="15sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F0F2F5" />

        <RadioButton
            android:id="@+id/rbColumn4"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:buttonTint="@color/accent_main"
            app:buttonTint="@color/accent_main"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="12dp"
            android:text="@string/_4_columns"
            android:textColor="@color/lumina_text_title"
            android:textSize="15sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F0F2F5" />

<!--        <RadioButton-->
<!--            android:id="@+id/rbColumn5"-->
<!--            android:layout_width="match_parent"-->
<!--            android:layout_height="48dp"-->
<!--            android:buttonTint="@color/lumina_primary"-->
<!--            app:buttonTint="@color/lumina_primary"-->
<!--            android:fontFamily="sans-serif-medium"-->
<!--            android:paddingStart="12dp"-->
<!--            android:visibility="gone"-->
<!--            android:text="@string/_5_columns"-->
<!--            android:textColor="@color/lumina_text_title"-->
<!--            android:textSize="15sp" />-->

    </RadioGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:weightSum="2">

        <TextView
            android:id="@+id/btnCancelColumns"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_cancel_button"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-bold"
            android:gravity="center"
            android:text="@string/cancel"
            android:textColor="#4B5563"
            android:textSize="15sp"
            android:textStyle="bold" />


        <TextView
            android:id="@+id/btnOkColumns"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_lumina_primary_button"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-bold"
            android:gravity="center"
            android:text="@string/ok"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
