<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">

    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivPhoto"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="#F0F0F0"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/RoundedPhotoCorner" />

        <ImageView
            android:id="@+id/ivFavoriteBadge"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="4dp"
            android:src="@drawable/ic_heart_filled"
            android:visibility="gone"
            app:tint="#EF4444" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPhotoName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="IMG_20260815.jpg"
            android:textColor="@color/lumina_text_title"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvPhotoDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:text="2.4 MB • Today"
            android:textColor="@color/lumina_text_secondary"
            android:textSize="13sp" />

    </LinearLayout>

    <ImageView
        android:id="@+id/ivChevron"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/lumina_text_secondary" />

    <ImageView
        android:id="@+id/ivSelectCheck"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/icn_unselected"
        android:visibility="gone" />

</LinearLayout>
