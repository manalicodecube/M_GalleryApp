<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="4dp">

      <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivFeaturedVideoThumbnail"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#222222"
        android:scaleType="centerCrop"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/RoundedCardCorner" />

    <View
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_bottom_gradient"
        app:layout_constraintBottom_toBottomOf="@id/ivFeaturedVideoThumbnail"
        app:layout_constraintEnd_toEndOf="@id/ivFeaturedVideoThumbnail"
        app:layout_constraintStart_toStartOf="@id/ivFeaturedVideoThumbnail" />

    <ImageView
        android:id="@+id/ivPlayFeatured"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:src="@drawable/ic_play_btn"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/ivFeaturedVideoThumbnail"
        app:layout_constraintEnd_toEndOf="@id/ivFeaturedVideoThumbnail"
        app:layout_constraintStart_toStartOf="@id/ivFeaturedVideoThumbnail"
        app:layout_constraintTop_toTopOf="@id/ivFeaturedVideoThumbnail" />

    <TextView
        android:id="@+id/tvFeaturedTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="14dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-bold"
        android:maxLines="1"
        android:text="Featured Video"
        android:textColor="@color/white"
        android:textSize="17sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/ivFeaturedVideoThumbnail"
        app:layout_constraintEnd_toStartOf="@id/tvFeaturedDuration"
        app:layout_constraintStart_toStartOf="@id/ivFeaturedVideoThumbnail" />

    <TextView
        android:id="@+id/tvFeaturedDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_duration_badge"
        android:fontFamily="sans-serif-medium"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:text="3:14"
        android:textColor="@color/white"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@id/ivFeaturedVideoThumbnail"
        app:layout_constraintEnd_toEndOf="@id/ivFeaturedVideoThumbnail" />

</androidx.constraintlayout.widget.ConstraintLayout>
